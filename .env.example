# FoodBridge Environment Variables
# Copy this file to .env and populate with your credentials

# ============================================================
# Database Configuration — Supabase (Recommended)
# ============================================================
# Connection String from Supabase Settings -> Database -> Connection string -> URI
DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase API Credentials (from Supabase Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Set DB_TYPE to 'supabase' to explicitly select Supabase (optional, auto-detected if DATABASE_URL is set)
DB_TYPE=supabase

# ============================================================
# Database Configuration — MySQL (Alternative)
# ============================================================
DB_HOST=your-aiven-host.aivencloud.com
DB_PORT=20854
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb

# ============================================================
# JWT Security
# ============================================================
JWT_SECRET=your_jwt_secret_key_here

# ============================================================
# Email Configuration (Gmail with App Password)
# ============================================================
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

